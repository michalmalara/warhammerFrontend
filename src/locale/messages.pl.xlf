<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="en-US" target-language="pl" datatype="plaintext" original="ng2.template">
    <body>
      <!-- Character card tags -->
      <trans-unit id="character.tags.race" datatype="html">
        <source>Human</source>
        <target> Człowiek </target>
      </trans-unit>
      <trans-unit id="character.tags.heritage" datatype="html">
        <source>Empire Heritage</source>
        <target> Dziedzictwo Imperium </target>
      </trans-unit>

      <!-- Tabs -->
      <trans-unit id="tabs.skills" datatype="html">
        <source>Skills</source>
        <target> Umiejętności </target>
      </trans-unit>
      <trans-unit id="tabs.talents" datatype="html">
        <source>Talents</source>
        <target> Talenty </target>
      </trans-unit>
      <trans-unit id="tabs.combat" datatype="html">
        <source>Combat</source>
        <target> Walka </target>
      </trans-unit>
      <trans-unit id="tabs.inventory" datatype="html">
        <source>Inventory</source>
        <target> Ekwipunek </target>
      </trans-unit>

      <!-- Inventory placeholder -->
      <trans-unit id="inventory.placeholder" datatype="html">
        <source> Inventory view is under construction  move or copy items here as needed.</source>
        <target> Widok ekwipunku jest w trakcie tworzenia — przenieś lub skopiuj tu przedmioty wedle potrzeb. </target>
      </trans-unit>

