      <trans-unit id="fatePoints.title" datatype="html">
        <source>Fate Points</source>
        <target> Punkty Losu </target>
      </trans-unit>
      <trans-unit id="fatePoints.aria" datatype="html">
        <source>Fate points</source>
        <target> Punkty Losu </target>
      </trans-unit>
      <trans-unit id="fatePoints.fateLabel" datatype="html">
        <source>Fate</source>
        <target> Los </target>
      </trans-unit>
      <trans-unit id="fatePoints.fortuneLabel" datatype="html">
        <source>Fortune</source>
        <target> Fortuna </target>
      </trans-unit>

      <!-- Experience panel -->
      <trans-unit id="xp.title" datatype="html">
        <source>Experience</source>
        <target> Doświadczenie </target>
