      <trans-unit id="wounds.title" datatype="html">
        <source>Wounds</source>
        <target> Rany </target>
      </trans-unit>
      <trans-unit id="wounds.hpLabel" datatype="html">
        <source>HP</source>
        <target> PŻ </target>
      </trans-unit>
      <trans-unit id="wounds.decAria" datatype="html">
        <source>Decrease wounds</source>
        <target> Zmniejsz rany </target>
      </trans-unit>
      <trans-unit id="wounds.maxLabel" datatype="html">
        <source>Max:</source>
        <target> Maks.:</target>
      </trans-unit>
      <trans-unit id="wounds.incAria" datatype="html">
        <source>Increase wounds</source>
        <target> Zwiększ rany </target>
      </trans-unit>
