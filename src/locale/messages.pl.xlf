        <target> Do wydania </target>
      </trans-unit>
      <trans-unit id="xp.totalEarnedLabel" datatype="html">
        <source>Total earned </source>
        <target> Łącznie zdobyto </target>
      </trans-unit>
      <trans-unit id="xp.toNextProfession" datatype="html">
