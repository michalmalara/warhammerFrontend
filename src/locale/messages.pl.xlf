      <trans-unit id="stats.primaryHeader" datatype="html">
        <source>Primary Characteristics</source>
        <target> Cechy główne </target>
      </trans-unit>
      <trans-unit id="stats.secondaryHeader" datatype="html">
        <source>Secondary Characteristics</source>
        <target> Cechy drugorzędne </target>
      </trans-unit>
      <trans-unit id="stats.baseLabel" datatype="html">
        <source>Base:</source>
        <target> Baza:</target>
      </trans-unit>
      <trans-unit id="stats.advLabel" datatype="html">
        <source>Adv:</source>
        <target> Rozw.:</target>
      </trans-unit>

      <!-- Equipment table -->
      <trans-unit id="equipment.col.name" datatype="html">
        <source> Weapon / Gear </source>
        <target> Broń / Sprzęt </target>
      </trans-unit>
      <trans-unit id="equipment.col.enc" datatype="html">
        <source> Enc </source>
        <target> Obc. </target>
      </trans-unit>
      <trans-unit id="equipment.col.dmg" datatype="html">
        <source> Dmg </source>
        <target> Obr. </target>
      </trans-unit>
      <trans-unit id="equipment.col.range" datatype="html">
        <source> Range </source>
        <target> Zasięg </target>
      </trans-unit>
      <trans-unit id="equipment.col.qualities" datatype="html">
        <source> Qualities </source>
        <target> Cechy </target>
      </trans-unit>

