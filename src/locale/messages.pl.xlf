      <trans-unit id="skills.controlsAriaLabel" datatype="html">
        <source>Skill controls</source>
        <target> Kontrolki umiejętności </target>
      </trans-unit>
      <trans-unit id="skills.taken" datatype="html">
        <source>TAKEN</source>
        <target> WYBRANE </target>
      </trans-unit>
      <trans-unit id="skills.viewAll" datatype="html">
