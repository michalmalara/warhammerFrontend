<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="en" datatype="plaintext" original="ng2.template">
    <body>
      <!-- skill-create.component.html -->
      <trans-unit id="skillCreate.title">
        <source>Skill Creation Editor</source>
        <target>Skill Creation Editor</target>
      </trans-unit>
      <trans-unit id="skillCreate.subtitle">
        <source>Define a new skill for the grim world of perilous adventure.</source>
        <target>Define a new skill for the grim world of perilous adventure.</target>
      </trans-unit>

      <trans-unit id="skillCreate.skillName.label">
        <source>Skill Name</source>
        <target>Skill Name</target>
      </trans-unit>
      <trans-unit id="skillCreate.skillName.placeholder">
        <source>e.g., Strike to Stun</source>
        <target>e.g., Strike to Stun</target>
      </trans-unit>
      <trans-unit id="skillCreate.skillName.aria">
        <source>Skill name</source>
        <target>Skill name</target>
      </trans-unit>
      <trans-unit id="skillCreate.skillName.error">
        <source>Required name (max 100 characters)</source>
        <target>Required name (max 100 characters)</target>
      </trans-unit>

      <trans-unit id="skillCreate.skillType.label">
        <source>Skill Type</source>
        <target>Skill Type</target>
      </trans-unit>
      <trans-unit id="skillCreate.skillType.aria">
        <source>Skill type</source>
        <target>Skill type</target>
      </trans-unit>
      <trans-unit id="skillCreate.skillType.error">
        <source>Choose a skill type</source>
        <target>Choose a skill type</target>
      </trans-unit>

      <trans-unit id="skillCreate.characteristic.aria">
        <source>Related characteristic</source>
        <target>Related characteristic</target>
      </trans-unit>
      <trans-unit id="skillCreate.characteristic.label">
        <source>Related Characteristic</source>
        <target>Related Characteristic</target>
      </trans-unit>
      <trans-unit id="skillCreate.characteristic.groupAria">
        <source>Choose related characteristic</source>
        <target>Choose related characteristic</target>
      </trans-unit>
      <trans-unit id="skillCreate.characteristic.error">
        <source>Choose a characteristic</source>
        <target>Choose a characteristic</target>
      </trans-unit>

      <trans-unit id="skillCreate.description.label">
        <source>Skill Description &amp; Lore</source>
        <target>Skill Description &amp; Lore</target>
      </trans-unit>
      <trans-unit id="skillCreate.description.placeholder">
        <source>Detail the mechanics and the flavor of this skill. How is it practiced in the Old World? What are the grim consequences of failure?</source>
        <target>Detail the mechanics and the flavor of this skill. How is it practiced in the Old World? What are the grim consequences of failure?</target>
      </trans-unit>
      <trans-unit id="skillCreate.description.aria">
        <source>Skill description</source>
        <target>Skill description</target>
      </trans-unit>

      <trans-unit id="skillCreate.actions.discard.aria">
        <source>Discard</source>
        <target>Discard</target>
      </trans-unit>
      <trans-unit id="skillCreate.actions.discard">
        <source>Discard</source>
        <target>Discard</target>
      </trans-unit>
      <trans-unit id="skillCreate.actions.save.aria">
        <source>Affix seal</source>
        <target>Affix seal</target>
      </trans-unit>
      <trans-unit id="skillCreate.actions.save">
        <source>Affix Seal</source>
        <target>Affix Seal</target>
      </trans-unit>

      <!-- skill-create.component.ts ($localize) -->
      <trans-unit id="skillCreate.snack.success">
        <source>Skill created</source>
        <target>Skill created</target>
      </trans-unit>
      <trans-unit id="skillCreate.snack.error">
        <source>Failed to create skill</source>
        <target>Failed to create skill</target>
      </trans-unit>

      <!-- skills-list.component.html -->
      <trans-unit id="skillsList.srHeading">
        <source>Skills</source>
        <target>Skills</target>
      </trans-unit>
      <trans-unit id="skillsList.title">
        <source>The Great Library of Skills</source>
        <target>The Great Library of Skills</target>
      </trans-unit>
      <trans-unit id="skillsList.subtitle">
        <source>Consult the ancient scrolls to master the crafts of survival, intrigue, and combat in the Old World.</source>
        <target>Consult the ancient scrolls to master the crafts of survival, intrigue, and combat in the Old World.</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.aria">
        <source>Search and filters</source>
        <target>Search and filters</target>
      </trans-unit>
      <trans-unit id="skillsList.search.placeholder">
        <source>Search the archives for a skill...</source>
        <target>Search the archives for a skill...</target>
      </trans-unit>
      <trans-unit id="skillsList.search.aria">
        <source>Search skills</source>
        <target>Search skills</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.toggle.aria">
        <source>Toggle filters</source>
        <target>Toggle filters</target>
      </trans-unit>
      <trans-unit id="skillsList.filters.toggle">
        <source>Filter Results</source>
        <target>Filter Results</target>
      </trans-unit>

      <trans-unit id="skillsList.quickFilters.characteristic.aria">
        <source>Characteristic quick filter</source>
        <target>Characteristic quick filter</target>
      </trans-unit>
      <trans-unit id="skillsList.quickFilters.characteristic">
        <source>Characteristic: <x id="INTERPOLATION"/></source>
        <target>Characteristic: <x id="INTERPOLATION"/></target>
      </trans-unit>

      <trans-unit id="skillsList.count">
        <source>Showing <x id="INTERPOLATION"/> Skills</source>
        <target>Showing <x id="INTERPOLATION"/> Skills</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.panel.aria">
        <source>Filters panel</source>
        <target>Filters panel</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.type.title">
        <source>Type</source>
        <target>Type</target>
      </trans-unit>
      <trans-unit id="skillsList.filters.anyType">
        <source>Any</source>
        <target>Any</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.characteristic.title">
        <source>Characteristic</source>
        <target>Characteristic</target>
      </trans-unit>
      <trans-unit id="skillsList.filters.anyCharacteristic">
        <source>Any</source>
        <target>Any</target>
      </trans-unit>

      <trans-unit id="skillsList.filters.clear">
        <source>Clear filters</source>
        <target>Clear filters</target>
      </trans-unit>
      <trans-unit id="skillsList.filters.done">
        <source>Done</source>
        <target>Done</target>
      </trans-unit>

      <trans-unit id="skillsList.error.loadFailed">
        <source>Failed to load the skills list.</source>
        <target>Failed to load the skills list.</target>
      </trans-unit>
      <trans-unit id="skillsList.empty.noSkills">
        <source>No skills.</source>
        <target>No skills.</target>
      </trans-unit>
      <trans-unit id="skillsList.empty.noResults">
        <source>No results for the selected filters.</source>
        <target>No results for the selected filters.</target>
      </trans-unit>

      <trans-unit id="skillsList.grid.aria">
        <source>Skills list</source>
        <target>Skills list</target>
      </trans-unit>
      <trans-unit id="skillsList.skill.noDescription">
        <source>No description.</source>
        <target>No description.</target>
      </trans-unit>

      <trans-unit id="skillsList.tags.aria">
        <source>Tags</source>
        <target>Tags</target>
      </trans-unit>

      <trans-unit id="skillsList.delete.aria">
        <source>Delete skill</source>
        <target>Delete skill</target>
      </trans-unit>

      <trans-unit id="skillsList.loading">
        <source>Loading…</source>
        <target>Loading…</target>
      </trans-unit>

      <trans-unit id="skillsList.fab.add.aria">
        <source>Add skill</source>
        <target>Add skill</target>
      </trans-unit>

      <!-- skills-list.component.ts ($localize) -->
      <trans-unit id="skillsList.any">
        <source>Any</source>
        <target>Any</target>
      </trans-unit>
      <trans-unit id="skillsList.deleteConfirm.aria">
        <source>Confirm deletion of skill <x id="INTERPOLATION" equiv-text="{{skillName}}"/></source>
        <target>Confirm deletion of skill <x id="INTERPOLATION" equiv-text="{{skillName}}"/></target>
      </trans-unit>
    </body>
  </file>
